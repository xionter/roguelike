  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "- \u0414\u041B\u042F \u041F\u0415\u0420\u0415\u0414\u0412\u0418\u0416\u0415\u041D\u0418\u042F
    \u0418\u0421\u041F\u041E\u041B\u042C\u0417\u0423\u0419\u0422\u0415 \u041A\u041B\u0410\u0412\u0418\u0428\u0418
    \"WASD\", \u0410 \u041C\u042B\u0428\u042C \u2013 \u0414\u041B\u042F \u041F\u0420\u0418\u0426\u0415\u041B\u0418\u0412\u0410\u041D\u0418\u042F\n-
    \u041D\u0410\u0416\u041C\u0418\u0422\u0415 \u041F\u041A\u041C, \u0427\u0422\u041E\u0411\u042B
    \u0421\u041E\u0412\u0415\u0420\u0428\u0418\u0422\u042C \u041A\u0423\u0412\u042B\u0420\u041E\u041A\n-
    \u0418\u0421\u041F\u041E\u041B\u042C\u0417\u0423\u0419\u0422\u0415 \u041A\u041E\u041B\u0401\u0421\u0418\u041A\u041E
    \u041C\u042B\u0428\u0418 \u0418\u041B\u0418 \u0426\u0418\u0424\u0420\u042B \"1,
    2, 3, 4, 5\" \u0414\u041B\u042F \u0421\u041C\u0415\u041D\u042B \u041E\u0420\u0423\u0416\u0418\u042F\n-
    \u041D\u0410\u0416\u041C\u0418\u0422\u0415 \"-\", \u0427\u0422\u041E\u0411\u042B
    \u041F\u041E\u0421\u0422\u0410\u0412\u0418\u0422\u042C \u0422\u0415\u041A\u0423\u0429\u0415\u0415
    \u041E\u0420\u0423\u0416\u0418\u0415 \u0412 \u0420\u0423\u041A\u0410\u0425 \u0412
    \u041F\u0415\u0420\u0412\u042B\u0419 \u0421\u041B\u041E\u0422\n- \u0423 \u041B\u0410\u0417\u0415\u0420\u041D\u041E\u0413\u041E
    \u041F\u0418\u0421\u0422\u041E\u041B\u0415\u0422\u0410 \u0417\u0410\u0414\u0415\u0420\u0416\u041A\u0410
    \u041F\u0415\u0420\u0415\u0414 \u0412\u042B\u0421\u0422\u0420\u0415\u041B\u041E\u041C,
    \u041D\u0410\u0414\u041E \u041D\u0415\u041C\u041D\u041E\u0413\u041E \u041F\u041E\u0414\u041E\u0416\u0414\u0410\u0422\u042C\n-
    \u0427\u0422\u041E\u0411\u042B \u041F\u0420\u041E\u041F\u0423\u0421\u0422\u0418\u0422\u042C
    \u041D\u0410\u0427\u0410\u041B\u042C\u041D\u0423\u042E \u041A\u0410\u0422\u0421\u0426\u0415\u041D\u0423,
    \u041D\u0410\u0416\u041C\u0418\u0422\u0415 \"Enter\"\n- \u0415\u0421\u041B\u0418
    \u0412 \u041E\u0411\u041E\u0419\u041C\u0415 \u0417\u0410\u041A\u041E\u041D\u0427\u0418\u041B\u0418\u0421\u042C
    \u041F\u0410\u0422\u0420\u041E\u041D\u042B, \u041D\u0410\u0416\u041C\u0418\u0422\u0415
    \u041B\u041A\u041C \u0418\u041B\u0418 \"R\" \u0412 \u041B\u042E\u0411\u041E\u0419
    \u041C\u041E\u041C\u0415\u041D\u0422 \u0414\u041B\u042F \u041F\u0415\u0420\u0415\u0417\u0410\u0420\u042F\u0414\u041A\u0418\n-
    \u041D\u0410\u0416\u041C\u0418\u0422\u0415 \"E\", \u0427\u0422\u041E\u0411\u042B
    \u041E\u0422\u041A\u0420\u042B\u0422\u042C \u0421\u0423\u041D\u0414\u0423\u041A
    \u0418 \u041F\u041E\u041B\u0423\u0427\u0418\u0422\u042C \u041F\u0420\u0415\u0414\u041C\u0415\u0422\u042B\n-
    \u041D\u0410\u0416\u041C\u0418\u0422\u0415 \"ESC\", \u0427\u0422\u041E\u0411\u042B
    \u041E\u0422\u041A\u0420\u042B\u0422\u042C \u041C\u0415\u041D\u042E \u041D\u0410\u0421\u0422\u0420\u041E\u0415\u041A\n-
    GLHF YO :)"
  m_isRightToLeft: 0
